soong_namespace {
	imports: [
	    "hardware/oplus",
	],
}

cc_binary {
    name: "android.hardware.vibrator.service.legacy.oplus-richtap",
    vendor: true,
    cflags: [
        "-Wall",
        "-Werror",
        "-DLOG_TAG=\"android.hardware.vibrator.service\"",
    ],
    relative_install_path: "hw",
    init_rc: ["android.hardware.vibrator.service.legacy.oplus-richtap.rc"],
    vintf_fragments: [
        "android.hardware.vibrator.service.legacy.oplus-richtap.xml",
    ],
    srcs: [
        "service.cpp",
        "Vibrator.cpp",
    ],
    shared_libs: [
        "libcutils",
        "libutils",
        "liblog",
        "libbase",
        "libbinder_ndk",
        "libaacvibrator",
        "android.hardware.vibrator-V2-ndk",
    ],
}
